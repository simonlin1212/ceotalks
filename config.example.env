# CEO Talks 抓取端的设置示例。拷一份改名 config.env（不进仓库），按需改，跑之前：source config.env
# 不设也能跑：AI 默认关，数据和页面默认放在项目里。

# —— AI 判断（三选一）——
export LEADERS_AI=off                 # off / openai / command

# openai：任何 OpenAI 兼容的聊天接口
# export LEADERS_AI=openai
# export LEADERS_AI_URL=https://api.openai.com/v1/chat/completions
# export LEADERS_AI_MODEL=填模型名
# export LEADERS_AI_KEY_FILE=~/.config/leaders/ai.key   # key 写在这个文件里（只放 key 本身），别直接写进本文件
# export LEADERS_AI_MAX_TOKENS=4096   # 回答最长多少 token；Cloudflare Workers AI 默认只给 256，要设这个

# command：任何从标准输入读提示词、往标准输出写回答的命令
# export LEADERS_AI=command
# export LEADERS_AI_CMD="codex exec --skip-git-repo-check -s read-only -"

# export LEADERS_AI_TIMEOUT=180       # 一次最多等几秒

# —— 位置 ——
# export LEADERS_DATA=./data                     # 累积库
# export LEADERS_OUT=./site/data/leaders.json    # 给页面读的数据
# export LEADERS_PEOPLE=./fetcher/people.json    # 名单

# —— 网络 ——
# 默认照系统的 HTTPS_PROXY 走（国内要代理才上得了 YouTube）；要强制直连就设：
# export LEADERS_NO_PROXY=1
# 在机房的机器上跑（GitHub Actions、云服务器），开视频页会被要人机验证，不开：
# export LEADERS_MAX_PAGES=0
